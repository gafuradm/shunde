# ============ Shunde Tutor — конфигурация backend ============
# Скопируйте этот файл в backend/.env и заполните ключи.
# Приложение работает и БЕЗ ключей LLM (деградированный режим:
# эвристическая разметка + Википедия + бесплатный перевод), но качество
# объяснений и перевода будет ниже.

# --- Общие ---
APP_NAME=Shunde Tutor
DATA_DIR=data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=40
# Токен преподавателя (вводится в UI в настройках, чтобы иметь права хоста лекции)
TEACHER_TOKEN=teacher

# --- LLM (OpenAI-совместимый API: DeepSeek / OpenAI / OpenRouter / Ollama / vLLM) ---
# DeepSeek:      https://api.deepseek.com/v1        модель deepseek-chat
# OpenAI:        https://api.openai.com/v1          модель gpt-4o-mini
# OpenRouter:    https://openrouter.ai/api/v1       модель qwen/qwen-2.5-72b-instruct
# Ollama (локально): http://127.0.0.1:11434/v1      модель qwen2.5:14b    (ключ любой)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# Если ключ выдан шлюзом/прокси, точные имена моделей смотрите так:
#   curl -s "$LLM_BASE_URL/models" -H "Authorization: Bearer $LLM_API_KEY"
# Например, шлюз может отдавать только deepseek-v4-pro и deepseek-flash — тогда
# LLM_MODEL=deepseek-v4-pro, LLM_MODEL_FAST=deepseek-flash, LLM_DISABLE_THINKING=true
# (обе модели reasoning, иначе ответ может приходить пустым при малом max_tokens).
# Быстрая/дешёвая модель для генерации поисковых запросов и перевода (по желанию)
LLM_MODEL_FAST=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120
# true, если провайдер поддерживает response_format={"type":"json_object"}
LLM_JSON_MODE=false
# true, если модель умеет читать картинки (OCR сканов и слайдов)
LLM_VISION=false
# Отключать «размышления» reasoning-моделей: в запрос добавляется
# {"thinking": {"type": "disabled"}}.
# Для reasoning-моделей (DeepSeek-R1/V3.x и подобных шлюзов) рекомендуется true:
# мгновенный перевод субтитров и разметка работают заметно быстрее, а max_tokens
# не расходуется на reasoning (при малом лимите ответ мог приходить пустым).
# Если шлюз не знает этот параметр — он отправится повторно без него.
LLM_DISABLE_THINKING=false

# --- Веб-поиск для объяснений (опционально) ---
# Без ключей работают: Wikipedia API, DuckDuckGo (lite/html), Mojeek, HTML-выдача Bing.
TAVILY_API_KEY=
SERPER_API_KEY=
BING_SEARCH_KEY=
# Сколько страниц-источников выкачивать и скармливать модели (0 = только сниппеты)
SEARCH_PAGES=2
# Проверять DNS при загрузке страниц (анти-SSRF). Оставьте false, если интернет
# работает через VPN/Clash в режиме fake-IP: иначе все внешние страницы будут блокироваться.
SEARCH_DNS_GUARD=false

# --- Перевод речи без LLM (неофициальный публичный endpoint Google Translate) ---
ALLOW_GOOGLE_FREE_TRANSLATE=true

# --- Серверное распознавание речи (опционально, если не хотите опираться на Web Speech API) ---
ASR_API_KEY=
ASR_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1
