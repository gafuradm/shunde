# Адрес API. Если пусто — используются относительные пути /api и /ws
# (в dev-режиме их проксирует Vite на http://127.0.0.1:8000).
VITE_API_BASE=

# Адрес WebSocket-сервера. Если пусто — берётся из window.location.
VITE_WS_BASE=

# Куда проксировать запросы в dev-режиме (Vite proxy).
VITE_API_TARGET=http://127.0.0.1:8000
